# PhishViz local development configuration template
# Rename a copy of this file to .env and generate unique values locally.
# Never upload .env, real credentials, raw user exports, or run databases.

# REQUIRED: generate a random, unique string (32 random bytes is recommended).
PHISHVIZ_HASH_SALT=

# REQUIRED for Django when configured to reject missing secrets.
# Generate a separate random value; do not reuse PHISHVIZ_HASH_SALT.
DJANGO_SECRET_KEY=

# Local development only. Never enable for a publicly accessible deployment.
PHISHVIZ_DEBUG=True
